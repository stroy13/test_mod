<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:key="ROOT"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/appearance" android:key="Appearance">
        <com.gmail.heagoo.apkeditor.util.IconPickerPreference android:entries="@array/appicon_key" android:layout="@layout/item_iconlistpref" android:title="@string/launcher_icon" android:key="MyIcon" android:entryValues="@array/appicon_value" />
        <CheckBoxPreference android:title="@string/full_screen" android:key="FullScreen" android:summary="@string/full_screen_desc" />
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/theme_key" android:title="@string/app_theme" android:key="AppTheme" android:defaultValue="1" android:summary="@string/select_theme_desc" android:entryValues="@array/theme_value" />
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/language_key" android:title="@string/preferred_language" android:key="Language" android:summary="@string/select_language_desc" android:entryValues="@array/language_value" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/app_display">
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/order_key" android:title="@string/app_list_order" android:key="AppListOrder" android:entryValues="@array/order_value" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/apk_decoding" android:key="DecodeCategory">
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/decode_mode_key" android:title="@string/decode_mode" android:key="DecodeMode" android:entryValues="@array/decode_mode_value" />
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/smali_tool_names" android:title="@string/smali_decoder_title" android:summary="@string/smali_decoder_summary" android:key="SmaliDecoderVersion" android:defaultValue="modern" android:entryValues="@array/smali_tool_values" />
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/smali_tool_names" android:title="@string/smali_encoder_title" android:summary="@string/smali_encoder_summary" android:key="SmaliEncoderVersion" android:defaultValue="legacy" android:entryValues="@array/smali_tool_values" />
        <com.gmail.heagoo.apkeditor.DecodeDirectoryPreference android:title="@string/decode_dir" android:key="DecodeDirectory" android:summary="@string/decode_dir_summary_may_change" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/apk_building" android:key="ApkBuilding">
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/compression_level_key" android:title="@string/compression_level" android:key="CompressionLevel" android:defaultValue="6" android:summary="@string/compression_level_summary" android:entryValues="@array/compression_level_value" />
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/lab_zip_engine_names" android:title="@string/lab_zip_engine_title" android:key="LabZipEngine" android:summary="@string/lab_zip_engine_summary" android:defaultValue="libzip-1.12.1" android:entryValues="@array/lab_zip_engine_values" />
        <Preference android:title="@string/tool_manager_title" android:key="ToolManager" android:summary="@string/tool_manager_summary" />
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/aapt_version_names" android:title="@string/aapt_version_title" android:key="AaptVersion" android:defaultValue="aapt2-37" android:entryValues="@array/aapt_version_values" />
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/jadx_version_names" android:title="@string/jadx_version_title" android:key="JadxVersion" android:defaultValue="modern" android:entryValues="@array/jadx_version_values" />
        <com.gmail.heagoo.apkeditor.KeyListPreference android:entries="@array/signer_key" android:title="@string/sign_apk_with" android:key="SignApkWith" android:summary="@string/sign_apk_with_summary" android:entryValues="@array/signer_value_dont_translate" />
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/sign_schemes_names" android:title="@string/sign_schemes_title" android:key="SignSchemes" android:summary="@string/sign_schemes_summary" android:defaultValue="v123" android:entryValues="@array/sign_schemes_values" />
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/output_apkname_key" android:title="@string/output_apk_name" android:key="OutputApkName" android:summary="@string/output_apk_name_summary" android:entryValues="@array/output_apkname_value" />
        <CheckBoxPreference android:title="@string/smali_editing" android:key="SmaliEditingEnabled" android:summary="@string/smali_edit_summary" />
        <CheckBoxPreference android:title="@string/rebuild_confirmation" android:key="RebuildConfirmation" android:summary="@string/rebuild_confirm_d_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/others">
        <Preference android:title="@string/ai_models" android:key="LocalAiModels" android:summary="@string/ai_models_summary" />
        <Preference android:title="@string/clean_garbage" android:key="CleanGarbage" android:summary="@string/clean_garbage_summary" />
        <com.gmail.heagoo.apkeditor.LabListPreference android:entries="@array/file_extract_rename_key" android:title="@string/file_rename" android:key="FileRenameOption" android:summary="@string/file_extract_rename_summary" android:entryValues="@array/file_extract_rename_value" />
    </PreferenceCategory>
</PreferenceScreen>