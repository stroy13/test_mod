<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/lab_dialog_surface"
    android:padding="8dp">

    <TextView
        android:id="@+id/decode_all_files"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="?labCardBackground"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:text="@string/decode_all_files"
        android:textColor="?labText"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/decode_partial_files"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="?labCardBackground"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:text="@string/decode_partial_files"
        android:textColor="?labText"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="?labCardBackground"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:text="@android:string/cancel"
        android:textColor="?labText"
        android:textSize="15sp" />
</LinearLayout>
