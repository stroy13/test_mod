<?xml version="1.0" encoding="utf-8"?>
<!--
    Plus override of the manifest code row. Mirrors MT Manager: line-number
    gutter, indent/collapse strip, then monospace code. Colours, typeface and
    text size are applied by ManifestListAdapter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal">

    <TextView
        android:id="@id/line_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="right|top"
        android:paddingTop="1.0dip"
        android:paddingBottom="1.0dip"
        android:singleLine="true"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:textSize="13.0sp"
        android:textColor="?labMuted" />

    <ImageView
        android:id="@id/collapse_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@id/line_data"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:paddingLeft="2.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:singleLine="false"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:textSize="13.0sp"
        android:textColor="?labText" />

</LinearLayout>
